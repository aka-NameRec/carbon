{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carbon",
  "version": "0.1.0",
  "identifier": "local.carbon.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": { "windows": [{ "label": "main", "title": "Carbon", "width": 1100, "height": 750 }] },
  "plugins": { "deep-link": { "desktop": { "schemes": ["carbon"] } } },
  "bundle": { "active": true, "targets": "all" }
}
